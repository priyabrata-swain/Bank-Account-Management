@startuml
left to right direction
skinparam packageStyle rectangle

actor "Bank Customer" as Customer
actor "Bank Administrator" as Admin

rectangle "Bank Account Management System" {
    usecase "Create New Account" as UC1
    usecase "View Account Details" as UC2
    usecase "Perform Transaction\n(Deposit / Withdraw)" as UC3
    usecase "Update Account Information" as UC4
    usecase "Delete / Close Account" as UC5
    usecase "Generate Financial Report" as UC6
    usecase "Persist Data (Save / Load)" as UC7
}

Customer --> UC2
Customer --> UC3

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
@enduml